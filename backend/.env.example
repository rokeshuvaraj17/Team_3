# Copy to .env and fill in your values

# PostgreSQL: Supabase Dashboard → Project Settings → Database → Connection string (URI).
# ENOTFOUND = wrong host or project paused; use the exact URI from Supabase.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Server port (optional, default 3000)
PORT=3000

# Used when hashing passwords (signup) and verifying (login). Keep secret.
PASSWORD_SALT=Team_3_rocks

# Comma-separated list of exact frontend origins allowed by CORS in non-extension contexts.
# Required in production. Example:
# ALLOWED_ORIGINS=https://automateandapply.com,https://www.automateandapply.com
ALLOWED_ORIGINS=

# Autofill extension: use your custom LLM API (takes precedence over Gemini if set).
# Request: POST body { "prompt": "...", "system": "..." }; response: { "text": "..." } or OpenAI-style "choices[0].message.content".
# AUTOFILL_LLM_URL=https://your-api.com/v1/complete
# AUTOFILL_LLM_API_KEY=optional_bearer_token

# Fallback when AUTOFILL_LLM_URL is not set (Google Gemini).
# GEMINI_API_KEY=your_gemini_key

# JSearch (RapidAPI) job search. Get key from https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY is the X-RapidAPI-Key. Host defaults to jsearch.p.rapidapi.com.
JSEARCH_API_KEY=
JSEARCH_API_HOST=jsearch.p.rapidapi.com

# Rokesh Notify — login OTP (keep the live key in .env only, never in frontend).
NOTIFY_API_KEY=
NOTIFY_API_BASE=https://notifications.rokeshcloud.com/v1
NOTIFY_APP_NAME=Rokesh Job Portal
NOTIFY_FROM=MR Rokesh Softwares <noreply@notifications.rokeshcloud.com>
